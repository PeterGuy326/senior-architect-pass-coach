{
  "$schema": "https://raw.githubusercontent.com/fullstack-ai-infra/digital-employee/v0.3.0/configs/employee-package.schema.json",
  "schemaVersion": "employee-package.v1alpha1",
  "name": "senior-architect-pass-coach",
  "version": "0.2.0",
  "description": "A portable, read-only, pass-first private coach for China's Senior Software Architect exam, returning structured teaching results and authenticated progress-event proposals.",
  "license": "Apache-2.0",
  "authors": ["PeterGuy326"],
  "host": {
    "protocol": "agent-host.v1",
    "requiredCapabilities": ["structured_output"]
  },
  "entrypoints": {
    "skill": "./SKILL.md",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json"
  },
  "policy": {
    "mode": "read_only",
    "network": "deny",
    "filesystem": {
      "read": ["./knowledge/**", "./presentation.json"],
      "write": []
    },
    "mcpTools": []
  },
  "assets": [
    "./presentation.json",
    "./knowledge/README.md",
    "./knowledge/sources.json",
    "./evals/cases.json"
  ]
}
