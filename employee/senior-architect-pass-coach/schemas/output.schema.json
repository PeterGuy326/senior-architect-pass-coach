{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PeterGuy326/senior-architect-pass-coach/blob/main/employee/senior-architect-pass-coach/schemas/output.schema.json",
  "title": "Senior Architect Pass Coach portable structured teaching result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "teaching_result",
    "proposed_progress_events"
  ],
  "properties": {
    "teaching_result": {
      "$ref": "#/$defs/teachingResult"
    },
    "proposed_progress_events": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/progressEventProposal"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "teaching_result": {
            "type": "object",
            "properties": {
              "scope": {
                "const": "general"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "proposed_progress_events": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "proposed_progress_events": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "teaching_result": {
            "type": "object",
            "properties": {
              "scope": {
                "const": "personalized"
              },
              "status": {
                "const": "completed"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "action": {
      "enum": [
        "diagnose",
        "status",
        "today",
        "practice",
        "submit",
        "review",
        "mock",
        "case",
        "essay"
      ]
    },
    "subject": {
      "enum": [
        "comprehensive",
        "case",
        "essay"
      ]
    },
    "result": {
      "enum": [
        "mastered",
        "not_mastered",
        "needs_retest"
      ]
    },
    "sourceRef": {
      "enum": [
        "senior-software-architect-review",
        "user-supplied-local-review-material"
      ]
    },
    "teachingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "action",
        "status",
        "scope",
        "summary",
        "score_goal",
        "answer_visibility",
        "state_write_performed",
        "assessments",
        "learning_items",
        "feedback",
        "recommendations",
        "source_refs"
      ],
      "properties": {
        "schema_version": {
          "const": "architect-pass-coach-teaching-result.v1"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "status": {
          "enum": [
            "completed",
            "needs_input",
            "rejected"
          ]
        },
        "scope": {
          "enum": [
            "general",
            "personalized"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "score_goal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass_line",
            "safety_target"
          ],
          "properties": {
            "pass_line": {
              "const": 45
            },
            "safety_target": {
              "const": 52
            }
          }
        },
        "answer_visibility": {
          "enum": [
            "hidden",
            "revealed_after_submission",
            "not_applicable"
          ]
        },
        "state_write_performed": {
          "const": false
        },
        "assessments": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/assessment"
          }
        },
        "learning_items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/learningItem"
          }
        },
        "feedback": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/feedback"
          }
        },
        "recommendations": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/recommendation"
          }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "answer_visibility": {
                "enum": [
                  "hidden",
                  "not_applicable"
                ]
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "feedback": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "answer_visibility": {
                "const": "revealed_after_submission"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "feedback": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "action": {
                "const": "submit"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "answer_visibility": {
                "const": "revealed_after_submission"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "status",
                  "today"
                ]
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "answer_visibility": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "diagnose",
                  "practice",
                  "review",
                  "mock",
                  "case",
                  "essay"
                ]
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "answer_visibility": {
                "const": "hidden"
              },
              "feedback": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "topic_id",
        "result",
        "evidence"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "topic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "learningItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "kind",
        "subject",
        "topic_id",
        "prompt",
        "source_refs"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "diagnostic_question",
            "multiple_choice",
            "review_prompt",
            "mock_section",
            "case_task",
            "essay_task"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "topic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "text"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "result",
        "explanation",
        "source_refs"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "reference_answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "subject",
        "topic_id",
        "title",
        "reason",
        "minutes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "enum": [
            "diagnose",
            "practice",
            "review",
            "mock",
            "case",
            "essay"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "topic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 240
        }
      }
    },
    "progressEventProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_type",
        "subject",
        "topic_id",
        "result",
        "evidence",
        "proposal_only",
        "requires_authenticated_context"
      ],
      "properties": {
        "schema_version": {
          "const": "progress-event-proposal.v1"
        },
        "event_type": {
          "enum": [
            "diagnostic_result",
            "practice_result",
            "mock_result",
            "case_result",
            "essay_result",
            "retest_result"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "topic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item_id",
            "summary"
          ],
          "properties": {
            "item_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "proposal_only": {
          "const": true
        },
        "requires_authenticated_context": {
          "const": true
        }
      }
    }
  }
}
